# Database Configuration
DB_NAME=transcendence
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production

# CORS Configuration
# Laissé vide : autorise dynamiquement l'origine de chaque requête, pour
# pouvoir ouvrir le site depuis n'importe quelle IP du réseau local sans
# reconfiguration. Fixer une valeur (ex. https://mondomaine.fr) en prod.
CORS_ORIGIN=

# OAuth 42 (https://profile.intra.42.fr/oauth/applications)
FORTYTWO_CLIENT_ID=u-s4t2ud-7cf30abbc0392093c5a11cc29c075f8b865645e03576641d85259dfac3334e6f
FORTYTWO_CLIENT_SECRET=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
FORTYTWO_REDIRECT_URI=https://localhost:3000/api/auth/42/callback

# URL publique du frontend, utilisée pour la redirection après le login 42
FRONTEND_URL=https://localhost:3000

# Frontend Environment (passe par nginx, point d'entrée unique)
# Laissées vides : le frontend déduit l'URL de l'API/WS depuis l'origine du
# navigateur (marche depuis localhost ET depuis une IP du réseau local).
# Ne fixer ces valeurs que si l'API est servie depuis un host différent.
VITE_API_URL=
VITE_WS_URL=

# Node Environment
NODE_ENV=development
